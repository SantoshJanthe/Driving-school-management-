# Copy to .env.local for local development. Values below match `supabase start`
# defaults; replace them with your project's values (Project Settings > API) for
# staging/production. Only NEXT_PUBLIC_* variables reach the browser.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key printed by `supabase start`>
SUPABASE_SERVICE_ROLE_KEY=<service_role key printed by `supabase start`>   # server only; never NEXT_PUBLIC_

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000           # used for auth redirect URLs (password reset)
NEXT_PUBLIC_APP_NAME="Sample Motor Driving School"
DOCUMENTS_BUCKET=applicant-documents
MAX_UPLOAD_MB=10

# Monitoring (wired in a later milestone)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                                   # CI source-map upload only
SENTRY_ENVIRONMENT=development

# Local Supabase CLI (optional; used by `npm run db:test`)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Razorpay — server only. Never NEXT_PUBLIC_, never commit real values.
# Dashboard → Settings → API Keys. Use rzp_test_ keys until go-live.
# The Payments page calls the Payment Links API with these. The Cursor MCP launcher uses them too.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. Endpoint: /api/razorpay/webhook, event payment_link.paid.
RAZORPAY_WEBHOOK_SECRET=
